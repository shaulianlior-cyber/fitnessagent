HOST=127.0.0.1
PORT=3000
DB_PATH=./data/stage3.sqlite
DEMO_SHEETS_PATH=./data/stage2-demo-sheets.json
WEBHOOK_PATH=/telegram/webhook
# SECURITY: omitting this value leaves the Telegram webhook completely open.
# When set, requests must include x-telegram-bot-api-secret-token.
WEBHOOK_SECRET=
ALBUM_WINDOW_MS=2000
# Required only for model-routed chat and screenshot extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
# Required only for downloading Telegram screenshots.
TELEGRAM_BOT_TOKEN=
